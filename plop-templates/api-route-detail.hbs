import { NextRequest, NextResponse } from 'next/server';

import {{pascalCase name}}Model from '@/database/models/{{pascalCase name}}';
import mongooseConnect from '@/database/mongooseConnect';

export const dynamic = 'force-dynamic';

// GET - Get a single {{lowercase name}} by ID
export async function GET(request: NextRequest, context: { params: Promise<{ id: string }> }) {
  try {
    await mongooseConnect();
    const { id } = await context.params;
    const {{lowercase name}} = await {{pascalCase name}}Model.findById(id);

    if (!{{lowercase name}}) {
      return NextResponse.json({ error: '{{pascalCase name}} not found' }, { status: 404 });
    }

    return NextResponse.json({{lowercase name}});
  } catch (error) {
    console.error('Error fetching {{lowercase name}}:', error);
    return NextResponse.json({ error: 'Failed to fetch {{lowercase name}}' }, { status: 500 });
  }
}

// PUT - Update a {{lowercase name}}
export async function PUT(request: NextRequest, context: { params: Promise<{ id: string }> }) {
  try {
    await mongooseConnect();
    const body = await request.json();

    const { id } = await context.params;
    const {{lowercase name}} = await {{pascalCase name}}Model.findByIdAndUpdate(id, body, {
      new: true,
      runValidators: true,
    });

    if (!{{lowercase name}}) {
      return NextResponse.json({ error: '{{pascalCase name}} not found' }, { status: 404 });
    }

    return NextResponse.json({{lowercase name}});
  } catch (error) {
    console.error('Error updating {{lowercase name}}:', error);
    return NextResponse.json({ error: 'Failed to update {{lowercase name}}' }, { status: 500 });
  }
}

// DELETE - Delete a {{lowercase name}}
export async function DELETE(request: NextRequest, context: { params: Promise<{ id: string }> }) {
  try {
    await mongooseConnect();
    const { id } = await context.params;
    const {{lowercase name}} = await {{pascalCase name}}Model.findByIdAndDelete(id);

    if (!{{lowercase name}}) {
      return NextResponse.json({ error: '{{pascalCase name}} not found' }, { status: 404 });
    }

    return NextResponse.json({ message: '{{pascalCase name}} deleted successfully' });
  } catch (error) {
    console.error('Error deleting {{lowercase name}}:', error);
    return NextResponse.json({ error: 'Failed to delete {{lowercase name}}' }, { status: 500 });
  }
}

