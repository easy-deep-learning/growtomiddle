import { auth } from '@/auth';

import {{pascalCase name}}Model from '@/database/models/{{pascalCase name}}';
import mongooseConnect from '@/database/mongooseConnect';

// Get all {{pascalCase name}}s with pagination
export const getAll = async (params: { page: number; limit: number }) => {
  await mongooseConnect();

  const session = await auth();
  // Optionally do something with the session here

  return await {{pascalCase name}}Model.find()
    .sort({ createdAt: -1 })
    .skip((params.page - 1) * params.limit)
    .limit(params.limit)
    .lean();
};

