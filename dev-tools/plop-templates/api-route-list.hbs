import { NextRequest, NextResponse } from 'next/server';

import {{pascalCase name}}Model from '@/database/models/{{pascalCase name}}';
import mongooseConnect from '@/database/mongooseConnect';

export const dynamic = 'force-dynamic';

// GET - List all {{pascalCase name}}s
export async function GET(request: NextRequest) {
  try {
    await mongooseConnect();
    const { searchParams } = new URL(request.url);
    const pageParam = searchParams.get('page');
    const limitParam = searchParams.get('limit');
    const page = pageParam ? Number(pageParam) : 1;
    const limit = limitParam ? Number(limitParam) : 10;

    const {{pascalCase name}}s = await {{pascalCase name}}Model.find()
      .sort({ createdAt: -1 })
      .skip((page - 1) * limit)
      .limit(limit)
      .lean();
    return NextResponse.json({{pascalCase name}}s);
  } catch (error) {
    console.error('Error fetching {{pascalCase name}}s:', error);
    return NextResponse.json({ error: 'Failed to fetch {{lowercase name}}s' }, { status: 500 });
  }
}

// POST - Create a new {{pascalCase name}}
export async function POST(request: NextRequest) {
  try {
    await mongooseConnect();
    const body = await request.json();

    const {{pascalCase name}} = new {{pascalCase name}}Model(body);
    await {{pascalCase name}}.save();

    return NextResponse.json({{pascalCase name}}, { status: 201 });
  } catch (error) {
    console.error('Error creating {{pascalCase name}}:', error);
    return NextResponse.json({ error: 'Failed to create {{pascalCase name}}' }, { status: 500 });
  }
}

